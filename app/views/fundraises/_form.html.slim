div.bg-white.rounded-lg.shadow-md.p-6
  = simple_form_for fundraise, html: { class: "space-y-6" } do |f|
    - if fundraise.errors.any?
      div.bg-red-50.border.border-red-200.rounded-lg.p-4.mb-6
        h3.text-red-800.font-medium.mb-2
          = pluralize(fundraise.errors.count, "erro impediu", "erros impediram")
          |  que esta oferta fosse salva:
        ul.list-disc.list-inside.text-red-700.text-sm
          - fundraise.errors.full_messages.each do |message|
            li = message

    div.space-y-4
      div
        = f.label :title, class: "block text-sm font-medium text-gray-700 mb-1"
          svg.inline.w-4.h-4.mr-1 fill="currentColor" viewBox="0 0 20 20"
            path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"
          span Título da Oferta
        = f.input_field :title, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500 px-4 py-2.5 text-gray-900", placeholder: "Ex: Expansão da Fazenda Solar", maxlength: 255

      div
        = f.label :description, class: "block text-sm font-medium text-gray-700 mb-1"
          svg.inline.w-4.h-4.mr-1 fill="currentColor" viewBox="0 0 20 20"
            path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"
          span Descrição
        = f.input_field :description, as: :text, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500 px-4 py-2.5 text-gray-900", rows: 5, placeholder: "Descreva os detalhes da oferta..."

      div
        = f.label :target_cents, class: "block text-sm font-medium text-gray-700 mb-1"
          svg.inline.w-4.h-4.mr-1 fill="currentColor" viewBox="0 0 20 20"
            path d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"
            path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd"
          span Meta (em centavos)
        = f.input_field :target_cents, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500 px-4 py-2.5 text-gray-900", placeholder: "Ex: 100000 (R$ 1.000,00)"
        p.mt-1.text-xs.text-gray-500 💡 Dica: R$ 1.000,00 = 100000 centavos

      div
        = f.label :status, class: "block text-sm font-medium text-gray-700 mb-1"
          svg.inline.w-4.h-4.mr-1 fill="currentColor" viewBox="0 0 20 20"
            path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"
          span Status
        = f.input_field :status, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500 px-4 py-2.5 text-gray-900"

      div
        = f.label :starts_at, class: "block text-sm font-medium text-gray-700 mb-1"
          svg.inline.w-4.h-4.mr-1 fill="currentColor" viewBox="0 0 20 20"
            path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"
          span Data de Início
        input type="text" name="fundraise[starts_at]" id="fundraise_starts_at" value=(fundraise.starts_at&.strftime("%Y-%m-%d %H:%M")) data-controller="flatpickr" class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500 px-4 py-2.5 text-gray-900" placeholder="Selecione data e hora"

      div
        = f.label :ends_at, class: "block text-sm font-medium text-gray-700 mb-1"
          svg.inline.w-4.h-4.mr-1 fill="currentColor" viewBox="0 0 20 20"
            path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"
          span Data de Término
        input type="text" name="fundraise[ends_at]" id="fundraise_ends_at" value=(fundraise.ends_at&.strftime("%Y-%m-%d %H:%M")) data-controller="flatpickr" class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500 px-4 py-2.5 text-gray-900" placeholder="Selecione data e hora"

    div.flex.gap-3.pt-4
      = f.button :submit, class: "flex-1 bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2.5 rounded-lg font-medium transition-colors flex items-center justify-center gap-2"
        svg.w-5.h-5 fill="currentColor" viewBox="0 0 20 20"
          path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"
        span = f.object.persisted? ? "Atualizar Oferta" : "Criar Oferta"

      = link_to fundraises_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-700 px-6 py-2.5 rounded-lg font-medium transition-colors flex items-center justify-center gap-2"
        svg.w-5.h-5 fill="currentColor" viewBox="0 0 20 20"
          path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"
        span Cancelar
