div.space-y-6
  div.flex.justify-between.items-center
    h1.text-3xl.font-bold.text-gray-900 Detalhes do Investimento
    div.flex.gap-2
      = link_to edit_investment_path(@investment), class: "bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-lg font-medium transition-colors flex items-center gap-2"
        svg.w-5.h-5 fill="currentColor" viewBox="0 0 20 20"
          path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"
        span Editar
      = link_to investments_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded-lg font-medium transition-colors flex items-center gap-2"
        svg.w-5.h-5 fill="currentColor" viewBox="0 0 20 20"
          path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"
        span Voltar

  div.bg-white.rounded-lg.shadow-md.overflow-hidden
    div.px-6.py-4.bg-gradient-to-r.from-green-500.to-green-600
      p.text-white.text-sm.font-medium Valor do Investimento
      p.text-white.text-4xl.font-bold.mt-1
        = number_to_currency((@investment.amount_cents || 0) / 100.0, unit: "R$ ", separator: ",", delimiter: ".")

    div.p-6
      dl.grid.grid-cols-1.md:grid-cols-2.gap-6
        div
          dt.flex.items-center.gap-2.text-sm.font-medium.text-gray-500
            svg.w-5.h-5.text-indigo-500 fill="currentColor" viewBox="0 0 20 20"
              path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"
            span Usuário
          dd.mt-2.text-lg.font-semibold.text-gray-900
            = link_to @investment.user.name, user_path(@investment.user), class: "text-indigo-600 hover:text-indigo-900"

        div
          dt.flex.items-center.gap-2.text-sm.font-medium.text-gray-500
            svg.w-5.h-5.text-purple-500 fill="currentColor" viewBox="0 0 20 20"
              path d="M3 12v3c0 1.657 3.134 3 7 3s7-1.343 7-3v-3c0 1.657-3.134 3-7 3s-7-1.343-7-3z"
              path d="M3 7v3c0 1.657 3.134 3 7 3s7-1.343 7-3V7c0 1.657-3.134 3-7 3S3 8.657 3 7z"
              path d="M17 5c0 1.657-3.134 3-7 3S3 6.657 3 5s3.134-3 7-3 7 1.343 7 3z"
            span Oferta
          dd.mt-2.text-lg.font-semibold.text-gray-900
            = link_to @investment.fundraise.title, fundraise_path(@investment.fundraise), class: "text-purple-600 hover:text-purple-900"

        div
          dt.flex.items-center.gap-2.text-sm.font-medium.text-gray-500
            svg.w-5.h-5.text-gray-500 fill="currentColor" viewBox="0 0 20 20"
              path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"
            span Data do Investimento
          dd.mt-2.text-sm.text-gray-900
            = l(@investment.created_at, format: :long)

        div
          dt.flex.items-center.gap-2.text-sm.font-medium.text-gray-500
            svg.w-5.h-5.text-gray-500 fill="currentColor" viewBox="0 0 20 20"
              path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"
            span Última Atualização
          dd.mt-2.text-sm.text-gray-900
            = l(@investment.updated_at, format: :long)
